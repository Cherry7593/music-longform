{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node", "vite/client"], "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "*.ts"],
  "exclude": ["node_modules", "out", "dist"]
}
